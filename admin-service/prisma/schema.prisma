generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

model BannedUser {
	id        Int      @id @default(autoincrement())
	userId    Int      @unique
	reason    String
	bannedBy  Int
	bannedAt  DateTime @default(now())

	@@map("banned_users")
}
